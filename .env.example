# Chat model (OpenRouter)
OPENROUTER_API_KEY=
MODEL=deepseek/deepseek-v4-flash

# Housekeeping model for memory + summaries (OpenAI-compatible, e.g. local vLLM)
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
HOUSEKEEPING_MODEL=adept3o

# OCR for PDFs (Nanonets OCR2, OpenAI-compatible). Leave empty to use the text layer only.
NANO_OCR_API_BASE_URL=
NANO_OCR_MODEL=ocr
# NANO_OCR_MAX_TOKENS=4096
# OCR_MODE=all          # all | missing (scanned pages only) | off

# Optional
USER_ID=demo-user
# DOCS_ROOT=docs
# MAX_READ_CHARS=100000
# MAX_TOOL_RESULT_CHARS=120000
# GROUNDING_MODE=retry   # retry | warn | off
# SPOTLIGHT_SECRET=   # otherwise generated once into .spotlight_secret

# Step 8: search across documents
# Postgres + pgvector (leave empty to use a local SQLite index in .doc_cache/)
VECTOR_DB_URL=postgresql://sift:sift@localhost:5432/sift
# Embeddings: any OpenAI-compatible endpoint (e.g. vLLM serving BAAI/bge-m3).
# Defaults to OPENAI_BASE_URL / OPENAI_API_KEY. EMBEDDING_MODEL=none -> keywords only.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# EMBEDDING_BASE_URL=http://localhost:8001/v1
# Jina instead: EMBEDDING_BASE_URL=https://api.jina.ai/v1  EMBEDDING_MODEL=jina-embeddings-v5-text-small
#   EMBEDDING_API_KEY=<jina key>  EMBEDDING_QUERY_TASK=retrieval.query  EMBEDDING_PASSAGE_TASK=retrieval.passage
# After changing the embedding model, rebuild: python search_index.py <user_id> --force
# One-line document summaries (defaults to HOUSEKEEPING_MODEL; none -> first line of the file)
# SUMMARY_MODEL=

# Steps 9-10
# MAX_FETCH_DOCS=10          # fetch_documents: max documents per call
# MAX_TABLE_CELLS=4000       # read_table_cells: max cells per call
# WORKFLOWS_DIR=workflows    # shared/ and users/<user_id>/ workflow folders

# LiteLLM proxy (litellm/config.yaml, start with ./litellm/run_proxy.sh).
# When LITELLM_BASE_URL is set, every chat-model call goes through the proxy and
# MODEL / HOUSEKEEPING_MODEL / CHAT_MODEL are its aliases: sift-local | sift-fast | sift-strong.
# LITELLM_MASTER_KEY=sk-...           # any secret; the proxy requires it
# LITELLM_BASE_URL=http://localhost:4000/v1
# LITELLM_API_KEY=${LITELLM_MASTER_KEY}
# MODEL=sift-fast                     # documents agent
# CHAT_MODEL=sift-local               # chat agent (planner route=chat)
# PLANNER_MODEL=sift-local            # planner's JSON call
# PLANNER_TIMEOUT=1.5                 # seconds; on timeout the turn goes to documents
